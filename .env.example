# ==========================================
# KrishiSetu AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# NEVER commit real production secrets to version control.
# ==========================================

# --- Backend Configuration ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=django-insecure-dev-only-placeholder-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_URL=krishi-portal-ops/
LOG_LEVEL=INFO

# Security / Proxy / CORS (Production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=https://krishisetu.vercel.app
SECURE_SSL_REDIRECT=True

# Database (Default: SQLite for local dev, Neon PostgreSQL for production)
DATABASE_URL=sqlite:///db.sqlite3
DB_CONN_MAX_AGE=600
DB_SSL_REQUIRE=True

# ML Artifact Path
MODEL_PATH=../ml/models/crop_model.joblib

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:8000/api
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Google OAuth Sign-In (Backend) ---
GOOGLE_OAUTH_CLIENT_IDS=your-google-oauth-client-id.apps.googleusercontent.com

# --- Krishi Mitra Chatbot & Retrieval ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your-gemini-api-key-here
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
CHAT_DAILY_LIMIT=500
CHAT_RATE_LIMIT=10/min

# --- Optional Observability ---
SENTRY_DSN=

# --- Email / Passwordless Auth OTP ---
# In local development (DEBUG=True), set ALLOW_CONSOLE_EMAIL=1 to print OTP codes directly to your terminal.
# EMAIL_PROVIDER options: brevo, resend, smtp, console (default: console in dev, brevo/resend recommended for free cloud hosts)
EMAIL_PROVIDER=console
BREVO_API_KEY=your-brevo-api-key-here
RESEND_API_KEY=your-resend-api-key-here
# For production email delivery via standard SMTP:
# NOTE: Render Free Tier blocks outbound SMTP on ports 25, 465, and 587. See docs/adr/0010-email-delivery.md and 0011-auth-methods.md.
ALLOW_CONSOLE_EMAIL=1
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
# Port 587: uses STARTTLS (EMAIL_USE_TLS=True, EMAIL_USE_SSL=False)
# Port 465: uses implicit SSL (EMAIL_USE_SSL=True, EMAIL_USE_TLS=False)
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
# For Gmail, EMAIL_HOST_USER must be your full address and EMAIL_HOST_PASSWORD must be a 16-character
# Google App Password (generated in Google Account -> Security -> 2-Step Verification -> App Passwords) without spaces.
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=KrishiSetu AI <your-email@gmail.com>
