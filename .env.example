# ==========================================
# KrishiSetu AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# NEVER commit real production secrets to version control.
# ==========================================

# --- Backend Configuration ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=django-insecure-dev-only-placeholder-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS settings (Frontend local dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (Default: SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///db.sqlite3

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:8000/api
